{
  "name": "dream-house",
  "version": "1.0.0",
  "private": true,
  "description": "A five-floor 3D dream house with a temple, playable music room, working lift, customizable character and a studio tanpura in any scale.",
  "type": "module",
  "scripts": {
    "start": "node serve.mjs",
    "test": "node --test --test-timeout=900000 tests/unit/*.test.js tests/world/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:world": "node --test --test-timeout=900000 tests/world/*.test.js",
    "test:e2e": "node tests/e2e/smoke.cjs"
  },
  "devDependencies": {
    "three": "0.187.0"
  },
  "engines": {
    "node": ">=20"
  }
}
